# ===== 爬虫服务配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- 浏览器 ----------
# true = 无头模式（生产）；false = 显示浏览器窗口（调试）
HEADLESS=true

# ---------- 存储 ----------
# 可选：csv | mysql（调试阶段可用 csv，免装数据库）
STORAGE_TYPE=mysql

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=crawler

# ---------- 采集平台开关 ----------
# 58 同城：商铺转让 / 生意转让 列表页地址，逗号分隔
CRAWL_58=true
CRAWL_58_URLS=https://xa.58.com/shangpucz/0/,https://xa.58.com/shengyizr/0/

# 安居客：商业地产 出租 / 转让
CRAWL_ANJUKE=false
CRAWL_ANJUKE_URLS=https://xa.sydc.anjuke.com/sp-zu/ly2/,https://xa.sydc.anjuke.com/sp-zhuan/ly2/

# 闲鱼：搜索关键词，逗号分隔
CRAWL_GOOFISH=false
CRAWL_GOOFISH_KEYWORDS=店铺转让,商铺出租,生意转让

# ---------- AI 语义分析（DeepSeek）----------
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_API_KEY=
AI_ENDPOINT=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat
AI_TIMEOUT=15000
AI_MAX_RETRIES=2
AI_CACHE_ENABLED=true

# ---------- 人工介入服务 ----------
REMOTE_SERVER_PORT=3456
# 对外访问地址（邮件链接用），留空则用 http://localhost:{PORT}
REMOTE_SERVER_URL=
# 爬虫端与操作员端的认证令牌，务必改为随机字符串
REMOTE_AUTH_TOKEN=change-me-to-a-random-token

# ---------- 邮件通知（可选，留空则不发送）----------
NOTIFY_ON_VERIFICATION=true
NOTIFY_EMAIL_HOST=
NOTIFY_EMAIL_PORT=465
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASS=
NOTIFY_EMAIL_TO=
