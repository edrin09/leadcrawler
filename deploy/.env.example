# ============================================
# 采集系统 Docker 部署环境变量配置
# 复制此文件为 .env 并修改相应配置
# ============================================

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 采集服务 ----------
CRAWLER_PORT=3001
METRICS_PORT=9091
CRAWLER_CPU_LIMIT=2
CRAWLER_MEMORY_LIMIT=2G

# ---------- Webman 管理后台 ----------
WEBMAN_PORT=8787
APP_DEBUG=false

# ---------- 数据库配置 (Webman) ----------
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=crawler
DB_USERNAME=root
DB_PASSWORD=

# ---------- 调度服务 ----------
SCHEDULER_PORT=3000
CRAWLER_API_URL=http://crawler:3001

# ---------- 采集任务开关 ----------
CRAWL_58=true
CRAWL_ANJUKE=true
CRAWL_GOOFISH=false
CRAWL_XIAOHONGSHU=false
CRAWL_DOUYIN=false

# ---------- 采集任务 Cron 表达式 ----------
CRAWL_58_CRON=0 */6 * * *
CRAWL_ANJUKE_CRON=0 */4 * * *
CRAWL_GOOFISH_CRON=0 */8 * * *
CRAWL_XIAOHONGSHU_CRON=0 */12 * * *
CRAWL_DOUYIN_CRON=0 */12 * * *

# ---------- 存储 ----------
STORAGE_TYPE=sqlite
SQLITE_PATH=/app/crawler/storage/data.db

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_DIR=/app/crawler/logs

# ---------- 截图 ----------
SCREENSHOT_DIR=/app/crawler/screenshots
OUTPUT_DIR=/app/crawler/output

# ---------- 验证码服务 ----------
CAPTCHA_API_KEY=
CAPTCHA_API_URL=
CAPTCHA_MANUAL_DIR=/app/crawler/screenshots/manual

# ---------- 通知 ----------
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Nginx ----------
NGINX_PORT=80

# ---------- Prometheus ----------
PROMETHEUS_PORT=9090

# ---------- Grafana ----------
GRAFANA_PORT=3002
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ---------- Alertmanager ----------
ALERTMANAGER_PORT=9093