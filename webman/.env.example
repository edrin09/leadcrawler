# ===== 后台服务配置示例 =====
# 复制为 .env 后按需修改：cp .env.example .env

APP_DEBUG=true

# 数据库连接：mysql | sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crawler
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=ed_

# 使用 SQLite（需注释掉上方 mysql 配置）
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/crawler.db
