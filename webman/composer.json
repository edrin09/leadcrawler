{
  "name": "wolfcode/easyadmin8",
  "type": "project",
  "url": "https://github.com/EasyAdmin8/EasyAdmin8-webman",
  "description": "基于webman和Layui的快速开发的后台管理系统。",
  "keywords": [
    "webman",
    "easyadmin",
    "admin"
  ],
  "homepage": "https://easyadmin8.top/",
  "license": "MIT",
  "authors": [
    {
      "name": "wolfcode"
    }
  ],
  "require": {
    "ext-pdo": "*",
    "ext-pcntl": "*",
    "ext-curl": "*",
    "php": ">=8.2.0",
    "workerman/webman-framework": "^2.1.4",
    "webman/console": "^2.1",
    "webman/blade": "^1.5.7",
    "webman/captcha": "^1.0.5",
    "webman/cache": "^2.1.3",
    "webman/log": "^2.1.4",
    "webman/domain": "^2.1.0",
    "webman/think-orm": "^2.1.8",
    "topthink/think-validate": "^3.0.7",
    "monolog/monolog": "^2.11.0",
    "symfony/finder": "^7.4.",
    "psr/container": "^2.0.2",
    "doctrine/annotations": "^2.0.2",
    "phpoffice/phpspreadsheet": "^1.30.2",
    "aliyuncs/oss-sdk-php": "^2.7.2",
    "qcloud/cos-sdk-v5": "^2.6.16",
    "jianyan74/php-excel": "^1.0.2",
    "vlucas/phpdotenv": "^5.6.3",
    "overtrue/wechat": "5.36.4",
    "php-mcp/server": "^3.3",
    "rubix/ml": "^2.5",
    "next/var-dumper": "^0.1.1",
    "yangweijie/webman-ignition": "^1.0",
    "guzzlehttp/guzzle": "^7.10"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ]
  },
  "config": {
    "allow-plugins": {
      "easywechat-composer/easywechat-composer": true
    }
  }
}
